{
  "name": "local-manual-approval-happy-path",
  "sockets": {
    "request": "/run/lb/request.sock",
    "review": "/run/lb/review.sock"
  },
  "steps": [
    {
      "name": "submit_request",
      "actor": "requester",
      "socket": "/run/lb/request.sock",
      "action": "request.submit",
      "expected_status": "pending",
      "emits_event": "request_created"
    },
    {
      "name": "review_request",
      "actor": "approver",
      "socket": "/run/lb/review.sock",
      "expected_status": "approved",
      "emits_event": "request_approved"
    },
    {
      "name": "execute_request",
      "actor": "requester",
      "socket": "/run/lb/request.sock",
      "action": "request.execute",
      "expected_status": "executed",
      "emits_event": "execution_started"
    },
    {
      "name": "verify_audit_and_recovery",
      "actor": "operator",
      "socket": "/run/lb/review.sock",
      "expected_status": "executed",
      "emits_event": "execution_succeeded"
    }
  ],
  "invariants": [
    "single-writer broker owns all state transitions",
    "exact argv executes verbatim; summaries may be rewritten",
    "execute is one-time and never grants reusable privilege"
  ],
  "non_goals": [
    "plugin-first execution paths",
    "remote transport dependencies",
    "shell-string rewriting of executable argv"
  ]
}
